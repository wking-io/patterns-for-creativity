{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "patterns-for-creativity-laracon",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "laracon.wking.dev",
      "custom_domain": true
    }
  ]
}
